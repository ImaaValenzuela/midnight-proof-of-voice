# Local application configuration. The SDK takes explicit configuration.
MIDNIGHT_NETWORK=local
MIDNIGHT_PROOF_SERVER=http://127.0.0.1:6300
# npm run setup:env generates a random local password without overwriting .env.
VOICEPROOF_DATABASE_PASSWORD=
# API process only; start with node --env-file=.env services/api/dist/server.js.
PORT=3000
# Never put wallet seeds, holder secrets, or biometric data in this file.
